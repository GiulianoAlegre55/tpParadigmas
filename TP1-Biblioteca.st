!agregarLector: l "verificamos primero numero de lector y cuit"|existe| existe := lectores anySatisfy: [ :cadaElemento | ((cadaElemento numero) = l numero) | (cadaElemento cuit = l cuit)].(existe) ifFalse: [	 lectores add: l.	 ^ l ] ifTrue: [ 	Transcript show: 'El lector ya se encontraba en el sistema.'.	^ nil ].! !!Biblioteca methodsFor: 'testing' stamp: '2026-10-03T12:03:01.776-03:00' prior: 0!buscarLectoresPorApellido: unTexto |r|r:= lectores select:[:cada|cada apellido includesSubstring: unTexto caseSensitive: false].^r.! !!Biblioteca methodsFor: 'testing' stamp: '2026-10-03T12:03:01.777-03:00' prior: 0!cantidadDePrestamosDe: unNumero|p|p := self prestamosDe: unNumero.^ p size.! !!Biblioteca methodsFor: 'operations' stamp: '2026-10-03T12:03:01.778-03:00' prior: 0!catalogar: m|existe| existe := catalogo anySatisfy: [ :cadaElemento | ((cadaElemento codigo ) = m codigo)].(existe) ifFalse: [	 catalogo add: m.	 ^ m ] ifTrue: [ 	Transcript show: 'Ya existe un material con ese código'.	^ nil ].! !!Biblioteca methodsFor: 'accessing' stamp: '2026-10-03T12:03:01.78-03:00' prior: 0!catalogo^catalogo ! !!Biblioteca methodsFor: 'operations' stamp: '2026-10-03T12:03:01.781-03:00' prior: 0!devolver: unCodigo|p m|p := prestamos select:[:cada| cada estaVigente].m := p detect: [ :cadaPrestamoVigente| cadaPrestamoVigente material codigo = unCodigo ] ifNone: [ m:=nil].(m) ifNil:[	Transcript show: 'El material no se encuentra en la lista de prestamos vigentes'.	^nil.	].m registrarDevolucion: (datePort now).^m.! !!Biblioteca methodsFor: 'testing' stamp: '2026-10-03T12:03:01.782-03:00' prior: 0!esMoroso: unNumero ^ (self lectorNumero: unNumero )esMoroso .! !!Biblioteca methodsFor: 'testing' stamp: '2026-10-03T12:03:01.783-03:00' prior: 0!estaPrestado: unCodigo|p m|p := prestamos select:[:cada| cada estaVigente].m := p detect: [ :cadaPrestamoVigente| cadaPrestamoVigente material codigo = unCodigo ] ifNone: [ m:=nil].m